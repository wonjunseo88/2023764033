★ 1. FindLargest
INCLUDE Irvine32.inc
FindLargest PROTO, pArray:PTR SDWORD, count:DWORD
.data
array1 SDWORD 10,-5,3,99,-100
array2 SDWORD -7,-3,-9
array3 SDWORD 1,5,5,5,5,2,9,-8
.code
main PROC
INVOKE FindLargest, ADDR array1, LENGTHOF array1
call WriteInt
call Crlf
INVOKE FindLargest, ADDR array2, LENGTHOF array2
call WriteInt
call Crlf
INVOKE FindLargest, ADDR array3, LENGTHOF array3
call WriteInt
call Crlf
exit
main ENDP
FindLargest PROC USES ecx esi, pArray:PTR SDWORD, count:DWORD
mov esi,pArray
mov ecx,count
mov eax,[esi] ; 첫 요소를 최댓값으로 가정
add esi,4
dec ecx
jz Done ; 요소가 1개면 끝
L1:
cmp eax,[esi]
jge Next ; 부호 있는 비교
mov eax,[esi]
Next:
add esi,4
loop L1
Done:
ret
FindLargest ENDP
END main


